# /etc/porter.env — read once at start. Mode 0600: the secret lives here.
PORTER_CUBE_URL=https://ekanite.tch.harvard.edu:32223/api/v1/
PORTER_STATE_DIR=/var/lib/porter/sessions
PORTER_HOST=127.0.0.1
PORTER_PORT=4180
# The address browsers reach this door as, exactly as the address bar shows it (several: comma-separated).
# The door takes a password, and anything on its cookie, only from a page of this origin. Unset, it answers
# only as this machine's own names at the port (http://127.0.0.1:4180), which is right with no proxy in
# front and refuses every login made through one. Behind a reverse proxy, set it.
PORTER_PUBLIC_ORIGIN=https://porter.example.org
# The reverse proxy in front, whose X-Forwarded-For and X-Forwarded-Proto are believed: an address, a CIDR
# range, or loopback, linklocal, uniquelocal (several: comma-separated). Unset, nothing forwarded is believed
# and every visitor is counted as the proxy itself. With the proxy on this machine: loopback.
PORTER_TRUSTED_PROXIES=loopback
# At least twenty characters. Without it every browser is asked again at a restart.
PORTER_SECRET=change-me-to-something-long-and-private
# The chell that starts sessions; the one installed with the checkout by default.
PORTER_CHELL=/opt/mise/packages/chell/dist/index.js
# A day each, so a cookie and the session it names die together.
PORTER_COOKIE_HOURS=24
PORTER_IDLE_HOURS=24
# Optional: a folder of sounds served in place of the page's own
# (press/arrive/retreat/refuse .mp3). For the original LCARS beeps, which may
# not be redistributed and so are never in a package: kept here, outside the
# install, they survive an upgrade. Extract from your own LCARS-26.zip.
#PORTER_SOUNDS_DIR=/etc/porter/sounds
