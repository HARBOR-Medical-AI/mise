{
  "name": "@fnndsc/porter",
  "version": "0.9.3",
  "description": "PORTER: the mise display manager — logs an operator in, finds or starts their calypso, and shows them to argus",
  "type": "module",
  "main": "dist/porter.js",
  "bin": {
    "porter": "dist/porter.js"
  },
  "scripts": {
    "build": "rm -fr dist && tsc && chmod +x ./dist/porter.js && node ../../scripts/notes-build.mjs",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage",
    "start": "node dist/porter.js"
  },
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@fastify/reply-from": "^12.6.5",
    "@fnndsc/calypso": "^0.28.3",
    "@fnndsc/chell": "^5.19.9",
    "@fnndsc/cumin": "^3.29.5",
    "@fnndsc/menu": "^0.32.0",
    "@fnndsc/stratus": "^0.7.0",
    "fastify": "^5.12.5",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARBOR-Medical-AI/mise.git",
    "directory": "apps/porter"
  },
  "keywords": [
    "chris",
    "mise",
    "porter",
    "login",
    "display-manager"
  ]
}
