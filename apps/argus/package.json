    "@kitware/vtk.js": "^36.4.1",
    "@lezer/highlight": "^1.2.5",
    "@niivue/niivue": "^0.69.0",
    "@types/three": "^0.185.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "bsd-trek": "^0.4.1",
    "buffer": "^6.0.3",
    "d3-array": "^3.2.4",
