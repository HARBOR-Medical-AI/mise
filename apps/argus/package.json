    "test": "tsc --noEmit && NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "smoke": "node tests/smoke/smoke.mjs",
    "sounds": "node scripts/sounds_make.mjs",
