{
  "name": "@fnndsc/stratus",
  "version": "0.6.1",
  "description": "STRATUS: a mise session over the cloud substrate a Trusted Domain runs on — one backend, clouds as drivers, OCI first",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARBOR-Medical-AI/mise.git",
    "directory": "packages/stratus"
  },
  "homepage": "https://github.com/HARBOR-Medical-AI/mise/tree/main/packages/stratus#readme",
  "bugs": {
    "url": "https://github.com/HARBOR-Medical-AI/mise/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "stratus": "dist/stratus.js"
  },
  "files": [
    "dist",
    "manifests",
    "chris"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -fr dist && tsc && chmod +x ./dist/stratus.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage",
    "test:boot": "node scripts/stratusBoot.mjs",
    "prepublishOnly": "test -f dist/index.js && test -f dist/index.d.ts"
  },
  "keywords": [
    "mise",
    "stratus",
    "trusted-domain",
    "openshift",
    "oci",
    "fnndsc"
  ],
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^22.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@fnndsc/brasa": "^0.51.0",
    "@fnndsc/calypso": "^0.28.2",
    "@fnndsc/fond": "^0.6.0",
    "@fnndsc/menu": "^0.31.1",
    "chalk": "^4.1.2",
    "js-yaml": "^4.1.0",
    "oci-bastion": "2.144.0",
    "oci-common": "2.144.0",
    "oci-core": "2.144.0",
    "oci-dns": "2.144.0",
    "oci-identity": "2.144.0",
    "oci-limits": "2.144.0",
    "oci-loadbalancer": "2.144.0",
    "oci-objectstorage": "2.144.0",
    "oci-resourcemanager": "2.144.0",
    "oci-resourcesearch": "2.144.0"
  }
}
