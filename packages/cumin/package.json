{
  "name": "@fnndsc/cumin",
  "version": "3.29.5",
  "description": "Utility library for ChILI and other ChRIS-related JavaScript applications",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARBOR-Medical-AI/mise.git",
    "directory": "packages/cumin"
  },
  "homepage": "https://github.com/HARBOR-Medical-AI/mise/tree/main/packages/cumin#readme",
  "bugs": {
    "url": "https://github.com/HARBOR-Medical-AI/mise/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    },
    "./request-ledger": {
      "import": "./dist/net/requestLedger.js",
      "types": "./dist/net/requestLedger.d.ts",
      "require": "./dist/net/requestLedger.js"
    },
    "./dicom-payload": {
      "import": "./dist/pacs/dicomPayload.js",
      "types": "./dist/pacs/dicomPayload.d.ts",
      "require": "./dist/pacs/dicomPayload.js"
    },
    "./runtime-output": {
      "import": "./dist/output/runtimeOutput.js",
      "types": "./dist/output/runtimeOutput.d.ts",
      "require": "./dist/output/runtimeOutput.js"
    },
    "./package.json": "./package.json",
    "./login-failure": {
      "import": "./dist/connect/loginFailure.js",
      "types": "./dist/connect/loginFailure.d.ts",
      "require": "./dist/connect/loginFailure.js"
    }
  },
  "scripts": {
    "build": "rm -fr dist types && tsc && chmod +x ./dist/cli.js",
    "test": "jest --coverage",
    "prepublishOnly": "test -f dist/index.js && test -f dist/index.d.ts"
  },
  "bin": {
    "cumin": "dist/cli.js"
  },
  "keywords": [
    "chris",
    "utility",
    "fnndsc"
  ],
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "devDependencies": {
    "@types/chalk": "^0.4.31",
    "@types/figlet": "^1.5.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@fnndsc/chrisapi": "^1.25.0",
    "chalk": "^4.1.2",
    "figlet": "^1.7.0",
    "@fnndsc/fond": "^0.6.0",
    "@fnndsc/menu": "^0.32.0"
  }
}
