{
  "name": "@fnndsc/brasa",
  "version": "0.51.2",
  "description": "BRASA Runs Abstracted Shell Actions - the hostable ChRIS shell engine (kernel)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARBOR-Medical-AI/mise.git",
    "directory": "packages/brasa"
  },
  "homepage": "https://github.com/HARBOR-Medical-AI/mise/tree/main/packages/brasa#readme",
  "bugs": {
    "url": "https://github.com/HARBOR-Medical-AI/mise/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core.js",
      "types": "./dist/core.d.ts"
    },
    "./progress": {
      "import": "./dist/core/progress.js",
      "types": "./dist/core/progress.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -fr dist && tsc && node ../../scripts/buildinfo.mjs && node ../../scripts/notes-build.mjs",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --forceExit --passWithNoTests --coverage",
    "test:core-boot": "node scripts/coreBoot.mjs"
  },
  "keywords": [
    "chris",
    "fnndsc",
    "shell",
    "engine",
    "kernel"
  ],
  "author": "FNNDSC <dev@babyMRI.org>",
  "license": "MIT",
  "dependencies": {
    "@fnndsc/chili": "^3.8.2",
    "@fnndsc/fond": "^0.6.0",
    "@fnndsc/cumin": "^3.29.5",
    "@fnndsc/salsa": "^4.4.3",
    "bsd-trek": "^0.4.0",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "js-yaml": "^4.1.0",
    "minimatch": "^10.1.1",
    "ws": "^8.21.0",
    "@fnndsc/menu": "^0.32.0",
    "@fnndsc/orrery": "^0.7.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.5.2"
  }
}
