{
  "name": "@fnndsc/menu",
  "version": "0.32.0",
  "description": "The mise wire contract: envelope, session protocol, and result-model schemas that surfaces and the kernel both speak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARBOR-Medical-AI/mise.git",
    "directory": "packages/menu"
  },
  "homepage": "https://github.com/HARBOR-Medical-AI/mise/tree/main/packages/menu#readme",
  "bugs": {
    "url": "https://github.com/HARBOR-Medical-AI/mise/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./logo": {
      "import": "./dist/logo/brain.js",
      "types": "./dist/logo/brain.d.ts"
    },
    "./logo/td": {
      "import": "./dist/logo/tdMark.js",
      "types": "./dist/logo/tdMark.d.ts"
    },
    "./ansi": {
      "import": "./dist/ansi/ansi.js",
      "types": "./dist/ansi/ansi.d.ts"
    },
    "./surface": {
      "import": "./dist/surface.js",
      "types": "./dist/surface.d.ts"
    },
    "./games": {
      "import": "./dist/games/index.js",
      "types": "./dist/games/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -fr dist && tsc",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage",
    "prepublishOnly": "test -f dist/index.js && test -f dist/index.d.ts"
  },
  "keywords": [
    "chris",
    "mise",
    "wire-contract",
    "schema",
    "fnndsc"
  ],
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  },
  "type": "module"
}
