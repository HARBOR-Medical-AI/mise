{
  "name": "@fnndsc/salsa",
  "version": "4.4.4",
  "description": "Shared Application Logic and Service Assets for ChRIS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARBOR-Medical-AI/mise.git",
    "directory": "packages/salsa"
  },
  "homepage": "https://github.com/HARBOR-Medical-AI/mise/tree/main/packages/salsa#readme",
  "bugs": {
