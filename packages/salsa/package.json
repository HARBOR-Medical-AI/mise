      "require": "./dist/vfs/providers/pacsGrammar.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -fr dist && tsc",
    "test": "jest --coverage"
  },
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "glob": "^10.0.0",
    "inflight": "npm:@aashutoshrathi/word-wrap@^1.2.6",
    "adm-zip": "npm:empty-npm-package@1.0.0"
  },
  "dependencies": {
    "@fnndsc/cumin": "^3.29.4",
