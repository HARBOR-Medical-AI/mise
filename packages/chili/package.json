{
  "name": "@fnndsc/chili",
  "version": "3.8.2",
  "description": "ChILI handles Intelligent Line Interactions: A CLI and library for ChRIS, acting as the controller layer for business logic and user presentation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARBOR-Medical-AI/mise.git",
    "directory": "packages/chili"
  },
  "homepage": "https://github.com/HARBOR-Medical-AI/mise/tree/main/packages/chili#readme",
  "bugs": {
    "url": "https://github.com/HARBOR-Medical-AI/mise/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./utils": "./dist/utils.js",
    "./*": "./dist/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "chili": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x ./dist/index.js",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:coverage": "jest --coverage --coverageProvider=v8",
    "clean": "rm -rf dist types fnndsc-chili*tgz",
    "build:cumin": "cd ../cumin && npm run build",
    "build:chili": "npm run clean && npm install && npm run build",
    "build:all": "npm run build:cumin && npm run build:chili && npm run pack",
    "pack": "npm pack",
    "install:local": "npm i --ignore-scripts $(npm pack | tail -1)",
    "deploy": "npm run build:all && npm run install:local"
  },
  "files": [
    "dist/**/*",
    "docs/**/*",
    "config/**/*"
  ],
  "keywords": [
    "chris",
    "cli",
    "repl"
  ],
  "author": "FNNDSC <dev@babyMRI.org>",
  "license": "MIT",
  "dependencies": {
    "@fnndsc/cumin": "^3.29.5",
    "@fnndsc/fond": "^0.6.0",
    "@fnndsc/menu": "^0.32.0",
    "@fnndsc/salsa": "^4.4.0",
    "@fortawesome/fontawesome-free": "^6.6.0",
    "@fortawesome/fontawesome-svg-core": "^6.6.0",
    "@fortawesome/free-solid-svg-icons": "^6.6.0",
    "archy": "^1.0.0",
    "asciidoctor": "^4.0.1",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "figlet": "^1.7.0",
    "glob": "^11.1.0",
    "js-yaml": "^4.1.0",
    "marked": "^9.1.0",
    "marked-terminal": "^6.1.0",
    "omelette": "^0.4.17",
    "open": "^10.1.0",
    "table": "^6.8.1"
  },
  "devDependencies": {
    "@types/archy": "^0.0.36",
    "@types/cli-progress": "^3.11.6",
    "@types/figlet": "^1.5.8",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.5",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^22.0.0",
    "@types/node-fetch": "^2.6.11",
    "@types/omelette": "^0.4.4",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.5.2"
  }
}
