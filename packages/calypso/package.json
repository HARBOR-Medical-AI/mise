{
  "name": "@fnndsc/calypso",
  "version": "0.28.3",
  "description": "CALYPSO: the ChRIS session daemon — hosts a brasa engine for attached surfaces over a WebSocket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HARBOR-Medical-AI/mise.git",
    "directory": "packages/calypso"
  },
  "homepage": "https://github.com/HARBOR-Medical-AI/mise/tree/main/packages/calypso#readme",
  "bugs": {
    "url": "https://github.com/HARBOR-Medical-AI/mise/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "calypso": "dist/calypso.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./berth": {
      "import": "./dist/daemon/berth.js",
      "types": "./dist/daemon/berth.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -fr dist && tsc && chmod +x ./dist/calypso.js && node ../../scripts/notes-build.mjs",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage",
    "prepublishOnly": "test -f dist/index.js && test -f dist/index.d.ts"
  },
  "keywords": [
    "chris",
    "calypso",
    "wire-contract",
    "websocket",
    "fnndsc"
  ],
  "author": "Rudolph Pienaar",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.10",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@fnndsc/brasa": "^0.51.2",
    "@fnndsc/cumin": "^3.29.5",
    "chalk": "^4.1.2",
    "ws": "^8.18.0",
    "zod": "^4.6.7",
    "@fnndsc/menu": "^0.32.0"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  }
}
