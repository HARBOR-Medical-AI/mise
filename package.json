{
  "name": "@fnndsc/mise",
  "version": "0.0.0",
  "private": true,
  "description": "MISE Integrates the Sandwich Ecosystem \u2014 monorepo for the ChELL stack (cumin, salsa, chili, chell), each published independently to npm.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @fnndsc/fond && npm run build -w @fnndsc/menu && npm run build -w @fnndsc/orrery && npm run build -w bsd-trek && npm run build -w @fnndsc/argus && npm run build -w @fnndsc/cumin && npm run build -w @fnndsc/salsa && npm run build -w @fnndsc/chili && npm run build -w @fnndsc/brasa && npm run build -w @fnndsc/calypso && npm run build -w @fnndsc/stratus && npm run build -w @fnndsc/chell && npm run build -w @fnndsc/porter",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:tests": "eslint --config eslint.tests.config.mjs \"packages/*/tests/**/*.{ts,js}\" \"packages/*/test/**/*.{ts,js}\"",
    "lint:seam": "eslint --config eslint.seam.config.mjs \"packages/*/src/**/*.ts\"",
    "lint:casts": "node scripts/cast-ratchet.mjs",
    "lint:kernel": "node scripts/kernel-isolation.mjs",
    "lint:fond": "node scripts/fond-isolation.mjs",
    "lint:trek": "node scripts/trek-isolation.mjs",
    "lint:core-deps": "node scripts/core-dependency-ratchet.mjs",
    "lint:stratus-deps": "node scripts/stratus-cloud-ratchet.mjs",
    "lint:commands": "node scripts/command-declarations.mjs",
    "lint:prompt": "node scripts/prompt-parity.mjs",
    "lint:wire": "node scripts/wire-escapes.mjs",
    "lint:listings": "node scripts/listing-bounds.mjs",
    "lint:rpn": "node scripts/rpn-prepositions.mjs",
    "lint:changesets": "node scripts/changeset-names.mjs && node scripts/changeset-headlines.mjs",
    "docs:site": "typedoc && asciidoctor -D site docs/site/*.adoc",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "lint:aegis": "node scripts/aegis-lint.mjs",
    "docs:keys": "node scripts/keys-doc.mjs",
    "lint:orrery": "node scripts/orrery-layers.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@yao-pkg/pkg": "6.21.0",
    "asciidoctor": "^4.0.11",
    "esbuild": "0.28.1",
    "eslint": "^10.6.0",
    "eslint-plugin-jest": "^29.15.4",
    "typedoc": "^0.28.20",
    "typescript-eslint": "^8.62.1"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22",
    "npm": ">=11 <12"
  },
  "overrides": {
    "jest-config": {
      "glob": "^11.1.0"
    },
    "jest-runtime": {
      "glob": "^11.1.0"
    },
    "@jest/reporters": {
      "glob": "^11.1.0"
    },
    "test-exclude": {
      ".": "^7.0.1",
      "glob": "^11.1.0"
    },
    "adm-zip": "npm:empty-npm-package@1.0.0"
  }
}
